{
  "name": "tuitionbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TuitionBridge: competition prototype. Fictional data, simulated payments only.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "start": "node --import tsx src/server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "reset-demo": "tsx src/server/cli-reset.ts",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "eval": "tsx scripts/eval/run.ts",
    "eval:live": "tsx scripts/eval/run.ts --live",
    "evidence": "tsx scripts/export-evidence.ts",
    "licenses": "tsx scripts/licenses.ts",
    "demo:capture": "tsx scripts/capture-demo.ts",
    "test:summary": "tsx scripts/test-summary.ts",
    "deck": "tsx scripts/build-deck.ts",
    "package": "tsx scripts/package.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "pdfjs-dist": "^6.4.299",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
