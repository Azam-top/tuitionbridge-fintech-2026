# Copy to .env (git-ignored). Server-side only; never exposed to the browser.
# Leave APP_LLM_API_KEY empty to run the deterministic MOCK agent (labeled MOCK in the UI).
# Do NOT use ANTHROPIC_API_KEY: an exported key can switch Claude Code itself to API billing. This app reads only APP_* variables.
APP_LLM_API_KEY=
# Model id for the configured provider adapter, e.g. a current Claude model id from the provider's docs.
APP_LLM_MODEL=
APP_PORT=8787
APP_DB_PATH=data/tuitionbridge.sqlite
# 1 (default) enables the local demo reset endpoint; set 0 to disable.
APP_DEMO_MODE=1
