# Copy to .env (git-ignored). Server-side only; never exposed to the browser.
#
# LIVE mode (the real application, default). Real accounts, your own invoice, real sources. It needs a real model:
# there is NO stand-in agent in the live mode. Without these two values planning is disabled and the UI says "Setup required".
APP_LLM_API_KEY=
# Model id for the configured provider adapter (a current model id from the provider's docs).
APP_LLM_MODEL=
#
# Sources of payment options. Wise public quote endpoint: 1 = fetch live USD->KZT quotes (only currencies and the amount are sent).
APP_WISE_QUOTES=1
# National Bank of Kazakhstan official reference rate (a guide, never an offer). 0 disables it.
APP_NBK_RATES=1
#
APP_PORT=8787
# Separate database files per mode; a file stamped with one mode is refused by the other.
# live: data/live.sqlite   sandbox: data/sandbox.sqlite
#
# Do NOT use ANTHROPIC_API_KEY: an exported key can switch Claude Code itself to API billing. This app reads only APP_* variables.
#
# SANDBOX (competition check, fictional test data): start with `npm run start:sandbox`; it needs no key.
